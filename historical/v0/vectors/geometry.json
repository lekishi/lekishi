                {"claim_id": "lks:claim:vector-1", "interpretation": "display_anchor", "geojson": {"type": "Point", "coordinates": [108.9, 34.3]}, "precision": "unspecified", "notes": "label anchor only; the source does not assert this coordinate"}
              ]
            },
            "claims": [
              {"claim_id": "lks:claim:vector-1", "statement": "The source locates the event only in this broad region.", "asserts": "/geometry/0", "basis": "attested", "role": "main", "citations": [{"source_id": "lks:source:vector-a", "locator": {"kind": "page", "value": "12"}}]}
            ]
          }
        ]
      },
      "expect": {"valid": true}
    },
    {
      "id": "geometry/display-anchor-with-precision-rejected",
