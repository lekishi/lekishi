      "op": "playback_state",
      "input": {
        "time": {
          "source_expression": "630 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "instant",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 630, "era": "ce"},
            "end": {"year": 630, "era": "ce"}
          }
        },
        "playhead": {"year": 630, "era": "ce"}
      },
      "expect": {"result": "active"}
    },
    {
      "id": "time/playback/instant-inactive-elsewhere",
      "why": "A year-precision instant must not stay active across neighbouring years.",
      "op": "playback_state",
      "input": {
        "time": {
          "source_expression": "630 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "instant",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 630, "era": "ce"},
            "end": {"year": 630, "era": "ce"}
          }
        },
        "playhead": {"year": 631, "era": "ce"}
      },
      "expect": {"result": "inactive"}
    },
    {
      "id": "time/instant/start-end-mismatch-rejected",
      "why": "An instant with two different endpoints is an occurrence window, not an instant.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "630 to 631 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "instant",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 630, "era": "ce"},
            "end": {"year": 631, "era": "ce"}
          }
        }
      },
      "expect": {"error": "instant_start_end_mismatch"}
    },
    {
      "id": "time/instant/open-ended-rejected",
      "why": "An instant has two bounds; a one-sided bound is an open-ended occurrence, not an instant.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "after 630 CE",
          "calendar": "julian",
          "precision": "year",
