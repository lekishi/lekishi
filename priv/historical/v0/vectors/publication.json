          {
            "set_id": "lks:set:vector-2",
            "members": [{"record_id": "lks:event:vector-example", "revision_id": "lks:rev:vector-2"}],
            "published_at": "2026-01-06T00:00:00Z"
          }
        ]
      },
      "expect": {"valid": false, "codes": ["ambiguous_publication_order"]}
    },
    {
      "id": "publication/a-record-appears-at-most-once-per-set",
      "why": "A set names one revision per record, so related changes stay unambiguous.",
      "op": "validate",
      "input": {
        "documents": [
          {"kind": "event", "content": {"summary": "An event.", "event_types": ["occurrence"], "time": null}}
        ],
        "sets": [
          {
            "set_id": "lks:set:vector-1",
            "members": [
              {"record_id": "lks:event:vector-example", "revision_id": "lks:rev:vector-1"},
              {"record_id": "lks:event:vector-example", "revision_id": "lks:rev:vector-1"}
            ],
            "published_at": "2026-01-06T00:00:00Z"
          }
        ]
      },
      "expect": {"valid": false, "codes": ["duplicate_set_member"]}
    },
    {
      "id": "publication/declared-order-must-match-the-published-intervals",
      "why": "A published ordering assertion is checked against the intervals it orders, so a declared order the supports do not establish is rejected.",
      "op": "validate",
      "input": {
        "documents": [
          {"source_id": "lks:source:vector-a", "kind": "scholarly"},
          {
            "kind": "event",
            "record_id": "lks:event:vector-a",
            "content": {
              "summary": "An event that claims to precede an overlapping event.",
              "event_types": ["occurrence"],
              "time": {"source_expression": "735 to 745 CE", "calendar": "julian", "precision": "year", "mode": "occurrence_window", "interval": {"bounds": "two_sided", "boundary": "inclusive", "start": {"year": 735, "era": "ce"}, "end": {"year": 745, "era": "ce"}}, "ordering": [{"relation": "before", "record_id": "lks:event:vector-b", "claim_id": "lks:claim:vector-1"}]}
            },
            "claims": [
              {"claim_id": "lks:claim:vector-1", "statement": "The source places this event before the other.", "asserts": "/time", "basis": "attested", "role": "main", "citations": [{"source_id": "lks:source:vector-a", "locator": {"kind": "page", "value": "5"}}]}
            ]
          },
          {
            "kind": "event",
            "record_id": "lks:event:vector-b",
            "content": {
              "summary": "An overlapping event.",
              "event_types": ["occurrence"],
              "time": {"source_expression": "740 to 750 CE", "calendar": "julian", "precision": "year", "mode": "occurrence_window", "interval": {"bounds": "two_sided", "boundary": "inclusive", "start": {"year": 740, "era": "ce"}, "end": {"year": 750, "era": "ce"}}}
            },
            "claims": [
              {"claim_id": "lks:claim:vector-2", "statement": "The source dates the second event.", "asserts": "/time", "basis": "attested", "role": "main", "citations": [{"source_id": "lks:source:vector-a", "locator": {"kind": "page", "value": "6"}}]}
            ]
          }
        ],
        "sets": [
          {
            "set_id": "lks:set:vector-1",
            "members": [
              {"record_id": "lks:event:vector-a", "revision_id": "lks:rev:vector-1"},
              {"record_id": "lks:event:vector-b", "revision_id": "lks:rev:vector-1"}
            ],
            "published_at": "2026-01-06T00:00:00Z"
          }
        ]
      },
      "expect": {"valid": false, "codes": ["declared_order_not_supported"]}
    },
    {
