# Static-host routing for the Lekishi artifact.
#
# Both routes are prerendered, so `/atlas` is served from `atlas.html`. Cloudflare
# Pages resolves that automatically ("clean URLs"); this rewrite states it
# explicitly and also covers a trailing slash, so a direct request or a refresh
# never depends on host-specific path resolution.
/atlas /atlas.html 200
/atlas/ /atlas.html 200
