{
  "contract": "lekishi-historical-contract/v0",
  "document": "test_vectors",
  "area": "claims",
  "description": "Claim-basis vectors: the conventional basis, for a date that standard reference chronologies agree on, derived from a source that gives a sequence rather than a calendar date. The vectors pin that it names its conversion, cites the passage and the reference, asserts a time, and is never one side of a dispute. They also pin the tradition basis: what a source passes on as legend needs no attribution, is not itself a dispute, may be one side of one, and never shares a pointer with a conventional date.",
  "vectors": [
    {
      "id": "claims/a-conventional-date-is-valid",
      "why": "A date the source gives only by its sequence, which standard chronologies agree on, names its conversion and cites the passage and the reference that states the year.",
      "op": "validate",
      "input": {
        "documents": [
          {
            "source_id": "lks:source:vector-a",
            "kind": "primary"
          },
          {
            "source_id": "lks:source:vector-b",
            "kind": "scholarly"
          },
          {
            "kind": "event",
            "record_id": "lks:event:vector-battle",
            "published": true,
            "content": {
              "summary": "A battle the source dates only by its sequence.",
              "event_types": [
                "occurrence"
              ],
              "time": {
                "source_expression": "on the same days as the sea fights",
                "calendar": "julian",
                "precision": "year",
                "mode": "occurrence_window",
                "interval": {
                  "bounds": "two_sided",
                  "boundary": "inclusive",
                  "start": {
                    "year": 480,
                    "era": "bce"
                  },
                  "end": {
                    "year": 480,
                    "era": "bce"
                  }
                }
              }
            },
            "claims": [
              {
                "claim_id": "lks:claim:vector-1",
                "statement": "The source narrates the battle.",
                "asserts": "",
                "basis": "attested",
                "role": "main",
                "citations": [
                  {
                    "source_id": "lks:source:vector-a",
                    "locator": {
                      "kind": "section",
                      "value": "VII.210"
                    }
                  }
                ]
              },
              {
                "claim_id": "lks:claim:vector-2",
                "statement": "The source places the battle on the days of the sea fights; the standard chronology dates both to 480 BCE.",
                "asserts": "/time",
                "basis": "conventional",
                "role": "main",
                "convention": "Herodotean campaign seasons, standard chronology",
                "citations": [
                  {
                    "source_id": "lks:source:vector-a",
                    "locator": {
                      "kind": "section",
                      "value": "VIII.15"
                    }
                  },
                  {
                    "source_id": "lks:source:vector-b",
                    "locator": {
                      "kind": "section",
                      "value": "vol. V, ch. XL"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "expect": {
        "valid": true
      }
    },
