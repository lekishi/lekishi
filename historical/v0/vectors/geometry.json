              ]
            },
            "claims": [
              {"claim_id": "lks:claim:vector-1", "statement": "The source states the extent in these terms.", "asserts": "/geometry/0", "basis": "attested", "role": "main", "citations": [{"source_id": "lks:source:vector-a", "locator": {"kind": "page", "value": "18"}}]}
            ]
          }
        ]
      },
      "expect": {"valid": true}
    },
    {
