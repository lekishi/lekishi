# Dependencies.
/node_modules/

# Generated build output. `pnpm build` writes the deployable artifact to
# `build/`; `.svelte-kit/` is SvelteKit's generated types and intermediate
# output. Neither is committed, and neither is required for a clean build.
/build/
/.svelte-kit/

# The Cesium runtime (Workers, Assets, Widgets, ThirdParty) is copied out of the
# npm package by `pnpm sync:cesium` before a dev server or build starts, and
# SvelteKit copies it into `build/`. It is generated, not source.
/static/cesium/

# Browser-test output.
/test-results/
/playwright-report/

# Local review artifacts (screenshots, recordings) are never committed.
/.amp/in/

/.direnv/
/.nix/
/.amp/portals/
/.jj-quarantine/
/dbg/
.env
npm-debug.log
