{
  "contract": "lekishi-historical-contract/v0",
  "document": "test_vectors",
  "area": "calendars",
  "description": "Calendar vectors: the Mesoamerican Long Count calendar and its correlation, the Julian day number of 0.0.0.0.0 a source's conversion uses. The interval stays the converted civil year, so matching and playback are unchanged.",
  "vectors": [
    {
      "id": "calendars/a-long-count-date-with-its-correlation-is-valid",
      "why": "A Long Count date names the Julian day number of 0.0.0.0.0 its source's conversion uses, here the GMT correlation, and keeps the converted civil year as its interval.",
      "op": "validate",
      "input": {
        "documents": [
          {
            "source_id": "lks:source:vector-a",
            "kind": "primary"
          },
          {
            "kind": "place",
            "record_id": "lks:place:vector-harbour",
            "published": true,
            "content": {
              "summary": "The place vector-harbour.",
              "place_types": [
                "port"
              ],
              "names": [],
              "geometry": [
                {
                  "claim_id": "lks:claim:vector-90",
                  "interpretation": "approximate_point",
                  "geojson": {
                    "type": "Point",
                    "coordinates": [
                      121.0,
                      31.0
                    ]
                  },
                  "precision": "locality",
                  "notes": "placed at the locality the source names"
                }
              ]
            },
            "claims": [
              {
                "claim_id": "lks:claim:vector-90",
                "statement": "The source names vector-harbour.",
                "asserts": "",
                "basis": "attested",
                "role": "main",
                "citations": [
                  {
                    "source_id": "lks:source:vector-a",
                    "locator": {
                      "kind": "entry",
                      "value": "entry 90"
                    }
                  }
                ]
              }
            ]
          },
          {
            "kind": "event",
            "record_id": "lks:event:vector-stela",
            "published": true,
            "content": {
              "summary": "A stela with a Long Count date.",
              "event_types": [
                "occurrence"
              ],
              "time": {
                "source_expression": "7.16.3.2.13 6 Ben 16 Xul",
                "calendar": "mesoamerican_long_count",
                "precision": "year",
                "mode": "instant",
                "interval": {
                  "bounds": "two_sided",
                  "boundary": "inclusive",
                  "start": {
                    "year": 36,
                    "era": "bce"
                  },
                  "end": {
                    "year": 36,
                    "era": "bce"
                  }
                },
                "correlation": 584283
              },
              "places": [
