                {"claim_id": "lks:claim:vector-1", "interpretation": "display_anchor", "geojson": {"type": "Point", "coordinates": [108.9, 34.3]}, "precision": "site", "notes": "label anchor"}
              ]
            },
            "claims": [
              {"claim_id": "lks:claim:vector-1", "statement": "The source locates the event only in this broad region.", "asserts": "/geometry/0", "basis": "attested", "role": "main", "citations": [{"source_id": "lks:source:vector-a", "locator": {"kind": "page", "value": "12"}}]}
            ]
          }
        ]
      },
      "expect": {"valid": false, "codes": ["display_anchor_with_precision"]}
    },
    {
      "id": "geometry/display-anchor-needs-an-explanation",
      "why": "An anchor without an explanation can be mistaken for an asserted position.",
      "op": "validate",
      "input": {
        "documents": [
          {
            "kind": "place",
            "content": {
              "summary": "An unexplained anchor.",
              "place_types": ["region"],
              "names": [],
              "geometry": [{"claim_id": "lks:claim:vector-1", "interpretation": "display_anchor", "geojson": {"type": "Point", "coordinates": [108.9, 34.3]}, "precision": "unspecified"}]
