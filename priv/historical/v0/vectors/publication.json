            },
            "claims": [
              {"claim_id": "lks:claim:vector-2", "statement": "The source places this event first.", "asserts": "/time", "basis": "attested", "role": "main", "citations": [{"source_id": "lks:source:vector-a", "locator": {"kind": "page", "value": "6"}}]}
