          }
        ]
      },
      "expect": {"valid": false, "codes": ["display_anchor_without_notes"]}
    },
    {
      "id": "geometry/invented-radius-is-rejected",
      "why": "RFD 2: do not invent an uncertainty radius when the evidence supplies none.",
