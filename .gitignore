# Dependencies.
/node_modules/

# Generated build output. `pnpm build` writes the deployable artifact to
# `build/`; `.svelte-kit/` is SvelteKit's generated types and intermediate
# output. Neither is committed, and neither is required for a clean build.
/build/
/.svelte-kit/

# The Cesium runtime (Workers, Assets, Widgets, ThirdParty) is copied out of the
# npm package by `pnpm sync:cesium` before a dev server or build starts, and
# SvelteKit copies it into `build/`. It is generated, not source.
/static/cesium/

# The globe tiles are painted and packed by `pnpm sync:globe`
# (scripts/globe/build-tiles.py) before a dev server or build starts, from
# elevation it caches under .cache/globe/. Both are generated, not source.
/static/globe/
/.cache/

# Browser-test output.
/test-results/
/playwright-report/

# Local review artifacts (screenshots, recordings) are never committed.
/.amp/in/

/.direnv/
/.nix/
/.amp/portals/
/.jj-quarantine/
/dbg/
.env
npm-debug.log

# Globe spike: the elevation cache and the built tileset are regenerated by
# spikes/renderer/globe/build-tiles.py (about 200 MB, never committed).
/spikes/renderer/globe/.cache/
/spikes/renderer/globe/tiles/
/spikes/renderer/globe/out/
__pycache__/
