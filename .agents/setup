#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
nix_profile="/nix/var/nix/profiles/default"
nix_bin="$nix_profile/bin/nix"

step() {
	printf '\n==> %s\n' "$1"
}

step "Installing Nix"
if [[ ! -x "$nix_bin" ]]; then
	installer="$(mktemp)"
	trap 'rm -f "$installer"' EXIT
	curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
		https://artifacts.nixos.org/nix-installer \
		--output "$installer"
	chmod +x "$installer"
	"$installer" install linux --enable-flakes --no-confirm
	rm -f "$installer"
	trap - EXIT
fi

# The installer cannot update this running process.
# shellcheck disable=SC1091
source "$nix_profile/etc/profile.d/nix-daemon.sh"

step "Configuring the repository Nix environment for login shells"
profile_marker="# lekishi Nix development shell"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
	cat >>"$HOME/.bash_profile" <<EOF

$profile_marker
if [[ -z "\${IN_NIX_SHELL:-}" && -z "\${LEKISHI_NIX_ENV:-}" ]]; then
  case "\$PWD/" in
    "$repo_root/"*)
      export LEKISHI_NIX_ENV=1
      eval "\$("$nix_bin" print-dev-env "$repo_root")"
      export PATH="$nix_profile/bin:\$PATH"
      ;;
  esac
fi
EOF
fi

step "Realizing the pinned development toolchain"
"$nix_bin" develop "$repo_root" --command true

step "Installing the frontend workspace from the lockfile"
"$nix_bin" develop "$repo_root" --command pnpm install --frozen-lockfile

step "Building the globe tiles into static/globe"
"$nix_bin" develop "$repo_root" --command pnpm sync:globe

step "Installing the browser the end-to-end checks use"
"$nix_bin" develop "$repo_root" --command pnpm exec playwright install --with-deps chromium

step "Orb setup complete"
