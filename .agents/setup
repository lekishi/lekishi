#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

step() {
	printf '\n==> %s\n' "$1"
}

step "Finding or installing Nix"
# Orbs may already provide a user-profile Nix rather than a system install.
# Reuse it even before its profile has put it on this process's PATH.
nix_bin="$(command -v nix || true)"
if [[ -z "$nix_bin" ]]; then
	for candidate in "$HOME/.nix-profile/bin/nix" /nix/var/nix/profiles/default/bin/nix; do
		if [[ -x "$candidate" ]]; then
			nix_bin="$candidate"
			break
		fi
	done
fi

if [[ -z "$nix_bin" ]]; then
	installer="$(mktemp)"
	trap 'rm -f "$installer"' EXIT
	curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
		https://artifacts.nixos.org/nix-installer \
		--output "$installer"
	chmod +x "$installer"
	"$installer" install linux --enable-flakes --no-confirm
	rm -f "$installer"
	trap - EXIT

	# Only a new install needs to initialize this running process's environment.
	# shellcheck disable=SC1091
	source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
	nix_bin="$(command -v nix)"
fi
nix_bin_directory="$(dirname "$nix_bin")"

step "Configuring the repository Nix environment for login shells"
profile_marker="# lekishi Nix development shell"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
	cat >>"$HOME/.bash_profile" <<EOF

$profile_marker
if [[ -z "\${IN_NIX_SHELL:-}" && -z "\${LEKISHI_NIX_ENV:-}" ]]; then
  case "\$PWD/" in
    "$repo_root/"*)
      export LEKISHI_NIX_ENV=1
      eval "\$("$nix_bin" print-dev-env "$repo_root")"
      export PATH="$nix_bin_directory:\$PATH"
      ;;
  esac
fi
EOF
fi

# The flake provides Playwright's pinned browsers. `playwright install` would
# try to write its download lock and metadata into their read-only Nix store.
step "Realizing the pinned development toolchain and browsers"
"$nix_bin" develop "$repo_root" --command true

step "Installing the frontend workspace from the lockfile"
"$nix_bin" develop "$repo_root" --command pnpm install --frozen-lockfile

step "Building the globe tiles into static/globe"
"$nix_bin" develop "$repo_root" --command pnpm sync:globe

step "Orb setup complete"
