{
  "contract": "lekishi-historical-contract/v0",
  "document": "test_vectors",
  "area": "time",
  "description": "Boundary vectors for the v0 time contract: BCE/CE with no civil year zero, precision, inclusive endpoints, duration versus uncertain occurrence, open-ended bounds, undated exclusion, and calendar caveats. Each vector names the plausible wrong interpretation it separates from the contract.",
  "vectors": [
    {
      "id": "time/bce/civil-year-zero-rejected",
      "why": "Civil BCE/CE numbering has no year zero, so year 0 is not a valid era year.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "year 0",
          "calendar": "julian",
          "precision": "year",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 0, "era": "bce"},
            "end": {"year": 1, "era": "ce"}
          }
        }
      },
      "expect": {"error": "civil_year_zero"}
    },
    {
      "id": "time/bce/negative-year-rejected",
      "why": "Signs belong to the era field, not the year, so a negative year is a data error rather than -221 BCE.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "-221",
          "calendar": "julian",
          "precision": "year",
          "mode": "instant",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": -221, "era": "ce"},
            "end": {"year": -221, "era": "ce"}
          }
        }
      },
      "expect": {"error": "year_must_be_positive"}
    },
    {
      "id": "time/bce/no-year-zero-between-eras",
      "why": "1 BCE derives to astronomical 0 and 1 CE to 1, so the era boundary spans one ordinal step, not two.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "1 BCE to 1 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 1, "era": "bce"},
            "end": {"year": 1, "era": "ce"}
          }
        }
      },
      "expect": {"interval": {"start_astro": 0, "end_astro": 1, "mode": "occurrence_window"}}
    },
    {
      "id": "time/bce/one-bce-precedes-one-ce",
      "why": "The era boundary must not be read as a single year or as 1 CE preceding 1 BCE.",
      "op": "relation",
      "input": {
        "a": {
          "source_expression": "1 BCE",
          "calendar": "julian",
          "precision": "year",
          "mode": "instant",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 1, "era": "bce"},
            "end": {"year": 1, "era": "bce"}
          }
        },
        "b": {
          "source_expression": "1 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "instant",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 1, "era": "ce"},
            "end": {"year": 1, "era": "ce"}
          }
        }
      },
      "expect": {"result": "before"}
    },
    {
      "id": "time/precision/year-only-no-january-first",
      "why": "A year-only claim keeps year granularity; deriving a coordinate must not invent January 1.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "630 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "instant",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 630, "era": "ce"},
            "end": {"year": 630, "era": "ce"}
          }
        }
      },
      "expect": {
        "interval": {"start_astro": 630, "end_astro": 630, "start_month": null, "start_day": null, "mode": "instant"}
      }
    },
    {
      "id": "time/precision/year-with-month-rejected",
      "why": "January 1 must not be attached to a year-precision claim to make it look exact.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "630 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "instant",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 630, "era": "ce", "month": 1, "day": 1},
            "end": {"year": 630, "era": "ce", "month": 1, "day": 1}
          }
        }
      },
      "expect": {"error": "year_precision_has_month_or_day"}
    },
    {
      "id": "time/precision/day-requires-month-and-day",
      "why": "Day precision without a month or day is an incomplete date, not a year.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "630 CE",
          "calendar": "julian",
          "precision": "day",
          "mode": "instant",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 630, "era": "ce"},
            "end": {"year": 630, "era": "ce"}
          }
        }
      },
      "expect": {"error": "day_precision_requires_month_and_day"}
    },
    {
      "id": "time/precision/month-forbids-day",
      "why": "Month precision must not carry a day that the evidence does not support.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "the fifth month of 630 CE",
          "calendar": "julian",
          "precision": "month",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 630, "era": "ce", "month": 5, "day": 1},
            "end": {"year": 630, "era": "ce", "month": 5, "day": 30}
          }
        }
      },
      "expect": {"error": "month_precision_forbids_day"}
    },
    {
      "id": "time/precision/unspecified-requires-unknown-mode",
      "why": "A dated mode needs a precision; unspecified precision means the record is undated.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "unknown",
          "calendar": "unknown",
          "precision": "unspecified",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 730, "era": "ce"},
            "end": {"year": 760, "era": "ce"}
          }
        }
      },
      "expect": {"error": "dated_mode_requires_precision"}
    },
    {
      "id": "time/precision/unknown-mode-with-interval-rejected",
      "why": "An unusable date must not keep an interval that a consumer could treat as a match.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "sometime in the eighth century, unverified",
          "calendar": "unknown",
          "precision": "unspecified",
          "mode": "unknown",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 730, "era": "ce"},
            "end": {"year": 760, "era": "ce"}
          }
        }
      },
      "expect": {"error": "unknown_mode_has_interval"}
    },
    {
      "id": "time/century/eighth-century-ce",
      "why": "The 8th century CE is 701-800, not 700-799.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "8th century CE",
          "calendar": "julian",
          "precision": "century",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 701, "era": "ce"},
            "end": {"year": 800, "era": "ce"}
          }
        }
      },
      "expect": {"interval": {"start_astro": 701, "end_astro": 800}}
    },
    {
      "id": "time/century/first-century-bce",
      "why": "The 1st century BCE is 100 BCE to 1 BCE and crosses no year zero.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "1st century BCE",
          "calendar": "julian",
          "precision": "century",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 100, "era": "bce"},
            "end": {"year": 1, "era": "bce"}
          }
        }
      },
      "expect": {"interval": {"start_astro": -99, "end_astro": 0}}
    },
    {
      "id": "time/century/era-flip-is-not-a-century",
      "why": "Reading the 1st century BCE as 1 BCE to 100 CE would straddle the era boundary and invent a 101-year span.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "1st century BCE",
          "calendar": "julian",
          "precision": "century",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 1, "era": "bce"},
            "end": {"year": 100, "era": "ce"}
          }
        }
      },
      "expect": {"error": "century_span_mismatch"}
    },
    {
      "id": "time/decade/730s-ce",
      "why": "A decade in CE runs from the aligned year to nine years later.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "the 730s CE",
          "calendar": "julian",
          "precision": "decade",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 730, "era": "ce"},
            "end": {"year": 739, "era": "ce"}
          }
        }
      },
      "expect": {"interval": {"start_astro": 730, "end_astro": 739}}
    },
    {
      "id": "time/decade/730s-bce",
      "why": "A decade in BCE runs forward in time from the higher BCE year to the lower one.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "the 730s BCE",
          "calendar": "julian",
          "precision": "decade",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 739, "era": "bce"},
            "end": {"year": 730, "era": "bce"}
          }
        }
      },
      "expect": {"interval": {"start_astro": -738, "end_astro": -729}}
    },
    {
      "id": "time/decade/unaligned-span-rejected",
      "why": "A named decade is aligned; an arbitrary ten-year span is a year-precision range instead.",
      "op": "normalize_interval",
      "input": {
        "time": {
          "source_expression": "725 to 734",
          "calendar": "julian",
          "precision": "decade",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 725, "era": "ce"},
            "end": {"year": 734, "era": "ce"}
          }
        }
      },
      "expect": {"error": "decade_span_mismatch"}
    },
    {
      "id": "time/boundary/inclusive-shared-endpoint",
      "why": "A support interval ending in 740 shares the inclusive boundary year with a window starting in 740.",
      "op": "temporal_match",
      "input": {
        "time": {
          "source_expression": "730 to 740 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 730, "era": "ce"},
            "end": {"year": 740, "era": "ce"}
          }
        },
        "window": {"start": {"year": 740, "era": "ce"}, "end": {"year": 750, "era": "ce"}}
      },
      "expect": {"result": "possible"}
    },
    {
      "id": "time/boundary/one-year-short-is-outside",
      "why": "Half-open or exclusive endpoint readings would wrongly include this; the interval stops in 739.",
      "op": "temporal_match",
      "input": {
        "time": {
          "source_expression": "730 to 739 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 730, "era": "ce"},
            "end": {"year": 739, "era": "ce"}
          }
        },
        "window": {"start": {"year": 740, "era": "ce"}, "end": {"year": 750, "era": "ce"}}
      },
      "expect": {"result": "outside"}
    },
    {
      "id": "time/boundary/bounded-uncertainty-is-a-possible-match",
      "why": "RFD 2's example: an occurrence known only to fall between 730 and 760 CE is a possible match for 740-750 CE, not an assertion that it happened then.",
      "op": "temporal_match",
      "input": {
        "time": {
          "source_expression": "sometime between 730 and 760 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 730, "era": "ce"},
            "end": {"year": 760, "era": "ce"}
          }
        },
        "window": {"start": {"year": 740, "era": "ce"}, "end": {"year": 750, "era": "ce"}}
      },
      "expect": {"result": "possible"}
    },
    {
      "id": "time/boundary/contained-uncertainty-is-definite",
      "why": "Possible means it might fall outside the window; a window containing the whole support interval is a definite match even when the exact year is unknown.",
      "op": "temporal_match",
      "input": {
        "time": {
          "source_expression": "sometime between 730 and 760 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 730, "era": "ce"},
            "end": {"year": 760, "era": "ce"}
          }
        },
        "window": {"start": {"year": 700, "era": "ce"}, "end": {"year": 800, "era": "ce"}}
      },
      "expect": {"result": "definite"}
    },
    {
      "id": "time/boundary/disjoint-range-is-outside",
      "why": "An occurrence range entirely before the window does not match on the possible-match policy.",
      "op": "temporal_match",
      "input": {
        "time": {
          "source_expression": "700 to 720 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 700, "era": "ce"},
            "end": {"year": 720, "era": "ce"}
          }
        },
        "window": {"start": {"year": 740, "era": "ce"}, "end": {"year": 750, "era": "ce"}}
      },
      "expect": {"result": "outside"}
    },
    {
      "id": "time/boundary/day-precision-flags-year-granularity",
      "why": "v0 compares year spans; a day-precision comparison must say so instead of implying day-level matching.",
      "op": "temporal_match",
      "input": {
        "time": {
          "source_expression": "the third day of the third month, 740 CE",
          "calendar": "julian",
          "precision": "day",
          "mode": "instant",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 740, "era": "ce", "month": 3, "day": 3},
            "end": {"year": 740, "era": "ce", "month": 3, "day": 3}
          }
        },
        "window": {"start": {"year": 740, "era": "ce"}, "end": {"year": 750, "era": "ce"}}
      },
      "expect": {"result": "definite", "caveats": ["year_granularity_comparison"]}
    },
    {
      "id": "time/boundary/cross-calendar-comparison-is-flagged",
      "why": "A Julian year and a Gregorian window can differ by a year at the boundary; the comparison must be flagged rather than presented as exact.",
      "op": "temporal_match",
      "input": {
        "time": {
          "source_expression": "sometime between 730 and 760 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 730, "era": "ce"},
            "end": {"year": 760, "era": "ce"}
          }
        },
        "window": {"start": {"year": 740, "era": "ce"}, "end": {"year": 750, "era": "ce"}}
      },
      "expect": {"result": "possible", "caveats": ["cross_calendar_approximation"]}
    },
    {
      "id": "time/undated/null-never-matches-any-window",
      "why": "A record with no date information must not be treated as matching every window, including a window covering all years.",
      "op": "temporal_match",
      "input": {
        "time": null,
        "window": {"start": {"year": 1, "era": "ce"}, "end": {"year": 9999, "era": "ce"}}
      },
      "expect": {"result": "undated"}
    },
    {
      "id": "time/undated/unknown-mode-never-matches",
      "why": "A preserved source expression without a usable interval is undated, not a possible match.",
      "op": "temporal_match",
      "input": {
        "time": {
          "source_expression": "undated inscription, formerly read as 740",
          "calendar": "unknown",
          "precision": "unspecified",
          "mode": "unknown",
          "interval": null
        },
        "window": {"start": {"year": 700, "era": "ce"}, "end": {"year": 800, "era": "ce"}}
      },
      "expect": {"result": "undated"}
    },
    {
      "id": "time/undated/not-steppable",
      "why": "Undated records are excluded from chronological stepping instead of receiving a placeholder date.",
      "op": "steppable",
      "input": {"time": null},
      "expect": {"result": false}
    },
    {
      "id": "time/undated/has-no-chronological-key",
      "why": "Playback and stepping need no key for an undated record, and none may be invented.",
      "op": "chronological_key",
      "input": {"time": null},
      "expect": {"key": null}
    },
    {
      "id": "time/undated/not-continuous-activity",
      "why": "An undated record must not be animated as activity.",
      "op": "continuous_activity",
      "input": {"time": null},
      "expect": {"result": false}
    },
    {
      "id": "time/duration/continuous-activity-supported",
      "why": "A duration is activity supported across the interval, so continuous presentation is justified.",
      "op": "continuous_activity",
      "input": {
        "time": {
          "source_expression": "630 to 632 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "duration",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 630, "era": "ce"},
            "end": {"year": 632, "era": "ce"}
          }
        }
      },
      "expect": {"result": true}
    },
    {
      "id": "time/occurrence_window/no-continuous-activity",
      "why": "RFD 2: an uncertain occurrence must not be animated as continuous activity throughout its uncertainty range.",
      "op": "continuous_activity",
      "input": {
        "time": {
          "source_expression": "sometime between 730 and 760 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 730, "era": "ce"},
            "end": {"year": 760, "era": "ce"}
          }
        }
      },
      "expect": {"result": false}
    },
    {
      "id": "time/playback/duration-active-at-playhead",
      "why": "The playhead is inside a supported duration, so the record is active rather than merely contextual.",
      "op": "playback_state",
      "input": {
        "time": {
          "source_expression": "630 to 632 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "duration",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 630, "era": "ce"},
            "end": {"year": 632, "era": "ce"}
          }
        },
        "playhead": {"year": 631, "era": "ce"}
      },
      "expect": {"result": "active"}
    },
    {
      "id": "time/playback/occurrence-is-only-possible",
      "why": "Inside its uncertainty range an occurrence is possibly happening; presenting it as active would assert an unknown date.",
      "op": "playback_state",
      "input": {
        "time": {
          "source_expression": "sometime between 730 and 760 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 730, "era": "ce"},
            "end": {"year": 760, "era": "ce"}
          }
        },
        "playhead": {"year": 745, "era": "ce"}
      },
      "expect": {"result": "possible"}
    },
    {
      "id": "time/playback/occurrence-inactive-outside-range",
      "why": "Outside its range an uncertain occurrence is contextual only, not possible and not active.",
      "op": "playback_state",
      "input": {
        "time": {
          "source_expression": "sometime between 730 and 760 CE",
          "calendar": "julian",
          "precision": "year",
          "mode": "occurrence_window",
          "interval": {
            "bounds": "two_sided",
            "boundary": "inclusive",
            "start": {"year": 730, "era": "ce"},
            "end": {"year": 760, "era": "ce"}
          }
        },
        "playhead": {"year": 700, "era": "ce"}
