{
  "contract": "lekishi-historical-contract/v0",
  "document": "test_vectors",
  "area": "geometry",
  "description": "Geometry vectors: what the evidence supports versus what the atlas asserts, approximate points, source-supported areas, display anchors, unknown placement, route interpretation, and the refusal to invent a radius or confidence value. Every geometry entry must be backed by a claim that asserts it.",
  "vectors": [
    {
      "id": "geometry/approximate-point-is-valid",
      "why": "An approximate point with recorded precision and cited support is the ordinary case for a broadly located site.",
      "op": "validate",
      "input": {
        "documents": [
          {"source_id": "lks:source:vector-a", "kind": "scholarly"},
          {
            "kind": "place",
            "published": true,
            "content": {
              "summary": "A broadly located site.",
              "place_types": ["settlement"],
              "names": [],
              "geometry": [
                {"claim_id": "lks:claim:vector-1", "interpretation": "approximate_point", "geojson": {"type": "Point", "coordinates": [108.9, 34.3]}, "precision": "locality", "notes": "the source places the site in this locality without a surveyed position"}
              ]
            },
            "claims": [
              {"claim_id": "lks:claim:vector-1", "statement": "The source places the site in this locality.", "asserts": "/geometry/0", "basis": "attested", "role": "main", "citations": [{"source_id": "lks:source:vector-a", "locator": {"kind": "map", "value": "plate 3"}}]}
            ]
          }
        ]
      },
      "expect": {"valid": true}
    },
    {
      "id": "geometry/source-supported-area-is-valid",
      "why": "A source-supported area records the extent a source depicts without implying uniform probability or political control.",
      "op": "validate",
      "input": {
        "documents": [
          {"source_id": "lks:source:vector-a", "kind": "scholarly"},
          {
            "kind": "place",
            "published": true,
            "content": {
              "summary": "A region whose extent comes from a cited reconstruction.",
              "place_types": ["region"],
              "names": [],
              "geometry": [
                {"claim_id": "lks:claim:vector-1", "interpretation": "source_supported_area", "geojson": {"type": "Polygon", "coordinates": [[[108.9, 34.3], [110.1, 34.3], [110.1, 35.0], [108.9, 34.3]]]}, "precision": "region", "notes": "boundary as depicted by the cited reconstruction, not a surveyed limit"}
              ]
            },
            "claims": [
              {"claim_id": "lks:claim:vector-1", "statement": "The reconstruction depicts this extent.", "asserts": "/geometry/0", "basis": "cited_interpretation", "role": "main", "attributed_to": "Example Study B", "citations": [{"source_id": "lks:source:vector-a", "locator": {"kind": "map", "value": "figure 4"}}]}
            ]
          }
        ]
      },
      "expect": {"valid": true}
    },
    {
      "id": "geometry/unknown-location-is-valid-without-coordinates",
      "why": "A record with no usable placement stays in lists and details without a fabricated map position.",
      "op": "validate",
      "input": {
        "documents": [
          {"source_id": "lks:source:vector-a", "kind": "scholarly"},
          {
            "kind": "place",
            "published": true,
            "content": {
              "summary": "A site mentioned in the source without a usable placement.",
              "place_types": ["settlement"],
              "names": [],
              "geometry": [
                {"claim_id": "lks:claim:vector-1", "interpretation": "unknown", "geojson": null, "precision": "unspecified", "notes": "the source names the site but gives no usable position"}
              ]
            },
            "claims": [
              {"claim_id": "lks:claim:vector-1", "statement": "The source names the site without a position.", "asserts": "/geometry/0", "basis": "attested", "role": "main", "citations": [{"source_id": "lks:source:vector-a", "locator": {"kind": "page", "value": "44"}}]}
            ]
          }
        ]
      },
      "expect": {"valid": true}
    },
    {
      "id": "geometry/unknown-location-with-coordinates-rejected",
      "why": "An unknown placement must not carry coordinates that a renderer would draw as an asserted position.",
      "op": "validate",
      "input": {
        "documents": [
          {"source_id": "lks:source:vector-a", "kind": "scholarly"},
          {
            "kind": "place",
            "published": true,
            "content": {
              "summary": "An unknown placement with coordinates.",
              "place_types": ["settlement"],
              "names": [],
              "geometry": [
                {"claim_id": "lks:claim:vector-1", "interpretation": "unknown", "geojson": {"type": "Point", "coordinates": [108.9, 34.3]}, "precision": "unspecified", "notes": "no usable position"}
              ]
            },
            "claims": [
              {"claim_id": "lks:claim:vector-1", "statement": "The source names the site without a position.", "asserts": "/geometry/0", "basis": "attested", "role": "main", "citations": [{"source_id": "lks:source:vector-a", "locator": {"kind": "page", "value": "44"}}]}
            ]
          }
        ]
      },
      "expect": {"valid": false, "codes": ["geometry_unknown_has_geojson"]}
    },
    {
      "id": "geometry/unknown-location-needs-an-explanation",
      "why": "A missing placement must be documented as missing evidence rather than left unexplained.",
      "op": "validate",
      "input": {
        "documents": [
          {
            "kind": "place",
            "content": {
              "summary": "An unexplained missing placement.",
              "place_types": ["settlement"],
              "names": [],
              "geometry": [{"claim_id": "lks:claim:vector-1", "interpretation": "unknown", "geojson": null, "precision": "unspecified"}]
            }
          }
        ]
      },
      "expect": {"valid": false, "codes": ["geometry_unknown_without_notes"]}
    },
    {
